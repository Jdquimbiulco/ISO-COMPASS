# Configuración de Base de Datos para Supabase (PostgreSQL)
# En Supabase Dashboard -> Project Settings -> Database -> Connection string:

# 1. DATABASE_URL: Usar la URL de "Transaction" o "Session" con Connection Pooling (puerto 6543 o 5432)
DATABASE_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[TU-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Conexión directa a PostgreSQL (puerto 5432) para que Prisma ejecute migraciones sin PgBouncer
DIRECT_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[TU-REGION].pooler.supabase.com:5432/postgres"

# Clave secreta para autenticación y sesiones
AUTH_SECRET="iso-compass-super-secret-key-development-2026"

# Entorno
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
